{
  "name": "airecho",
  "version": "1.3.0",
  "description": "Тривоги та цілі NEPTUN у реальному часі з власною озвучкою",
  "license": "MIT",
  "author": "AirEcho",
  "homepage": "https://github.com/KoctrX/AirEcho",
  "repository": {
    "type": "git",
    "url": "https://github.com/KoctrX/AirEcho.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "web:dev": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts",
    "geo:update": "curl -fsSL --retry 5 --retry-all-errors https://neptun.in.ua/oblasts.geojson -o resources/geo/oblasts.geojson && curl -fsSL --retry 5 --retry-all-errors https://neptun.in.ua/raions.geojson -o resources/geo/raions.geojson"
  },
  "build": {
    "appId": "ua.airecho.app",
    "productName": "AirEcho",
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*",
          "!sw.js",
          "!manifest.webmanifest",
          "!icon-192.png",
          "!icon-512.png",
          "!icon-maskable-512.png",
          "!apple-touch-icon.png"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "resources/icon.png",
      "maintainer": "AirEcho contributors",
      "executableName": "airecho",
      "desktop": {
        "entry": {
          "StartupWMClass": "airecho",
          "Name": "AirEcho",
          "Comment": "Тривоги та цілі NEPTUN з власною озвучкою"
        }
      }
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.utilities",
      "identity": null
    }
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "fflate": "0.8.3",
    "maplibre-gl": "5.24.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
